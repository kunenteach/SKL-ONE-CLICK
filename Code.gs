/** iGEMKIDS backend for Google Apps Script + Google Sheets. */
function doGet() {
  initializeSheets();
  return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('iGEMKIDS - PRA PINTAR SKL').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL).addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function include(filename) { return HtmlService.createHtmlOutputFromFile(filename).getContent(); }
function getSpreadsheet_() { const configuredId = String(APP_CONFIG.SPREADSHEET_ID || '').trim(); if (configuredId) return SpreadsheetApp.openById(configuredId); const active = SpreadsheetApp.getActiveSpreadsheet(); if (active) return active; const props = PropertiesService.getScriptProperties(), savedId = props.getProperty('DATABASE_SPREADSHEET_ID'); if (savedId) return SpreadsheetApp.openById(savedId); const created = SpreadsheetApp.create(APP_CONFIG.APP_NAME + ' Database'); props.setProperty('DATABASE_SPREADSHEET_ID', created.getId()); return created; }
function now_() { return new Date(); }
function fmt_(date, pattern) { return Utilities.formatDate(date || now_(), APP_CONFIG.TIMEZONE, pattern); }
function clean_(value) { return String(value == null ? '' : value).trim().replace(/[<>]/g, ''); }
function normalizePassword_(value) { return String(value == null ? '' : value).trim().toUpperCase(); }
function normalizeLogin_(value) { return String(value == null ? '' : value).trim().toLowerCase(); }
function json_(value) { return JSON.stringify(value || {}); }
function sheet_(name) { return getSpreadsheet_().getSheetByName(name) || getSpreadsheet_().insertSheet(name); }
function headers_(name) { return APP_CONFIG.SHEETS[name]; }
/** Converts a Sheets cell into a value supported by google.script.run. */
function clientSafeCell_(value) {
  if (value instanceof Date) return fmt_(value, 'yyyy-MM-dd HH:mm:ss');
  return value == null ? '' : value;
}

/** Reads sheet rows as plain, browser-safe objects. */
function rows_(name) {
  const sh = sheet_(name), values = sh.getDataRange().getValues(), h = values.shift() || headers_(name);
  return values
    .filter(r => r.some(value => value !== '' && value != null))
    .map(r => Object.fromEntries(h.map((key, index) => [key, clientSafeCell_(r[index])])));
}
function writeRows_(name, rows) { const sh = sheet_(name), h = headers_(name); sh.clear(); sh.getRange(1,1,1,h.length).setValues([h]); if (rows.length) sh.getRange(2,1,rows.length,h.length).setValues(rows.map(o => h.map(k => o[k] == null ? '' : o[k]))); }
function append_(name, obj) { const h = headers_(name); sheet_(name).appendRow(h.map(k => obj[k] == null ? '' : obj[k])); }
function ok_(data, message) { return { success: true, message: message || 'Berjaya.', data: data || {} }; }
function fail_(message) { return { success: false, message: message || 'Ralat sistem.' }; }
function cacheRemove_() { CacheService.getScriptCache().removeAll(['settings','fields','standards','activeGames']); }
function hashPassword_(password) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(password)).map(b => ('0' + (b & 255).toString(16)).slice(-2)).join(''); }
function isSha256_(value) { return /^[a-f0-9]{64}$/i.test(String(value || '').trim()); }
function teacherPasswordValue_(teacher) { return String(teacher.PASSWORD_HASH || teacher.PASSWORD_H || teacher.PASSWORD || teacher.KATA_LALUAN || '').trim(); }
function teacherPasswordMatches_(teacher, plainPassword, hashedPassword) { const stored = teacherPasswordValue_(teacher); return stored === hashedPassword || (!isSha256_(stored) && stored === String(plainPassword == null ? '' : plainPassword).trim()); }
function upgradePlainTeacherPassword_(teacherId, plainPassword) { const rs = rows_('TEACHERS'), i = rs.findIndex(r => r.TEACHER_ID === teacherId); if (i < 0) return; rs[i].PASSWORD_HASH = hashPassword_(plainPassword); rs[i].UPDATED_AT = fmt_(now_(),'dd/MM/yyyy HH:mm:ss'); writeRows_('TEACHERS', rs); }
function token_() { return Utilities.getUuid().replace(/-/g, '') + Date.now(); }
function sessionKey_(token) { return 'SESSION_' + token; }
function createSession_(type, user) { const t = token_(); PropertiesService.getScriptProperties().setProperty(sessionKey_(t), json_({ type, user, lastSeen: Date.now() })); return t; }
function getSession_(token) { if (!token) return null; const p = PropertiesService.getScriptProperties(), raw = p.getProperty(sessionKey_(token)); if (!raw) return null; const s = JSON.parse(raw); if ((Date.now() - s.lastSeen) / 1000 > APP_CONFIG.SESSION_TTL_SECONDS) { p.deleteProperty(sessionKey_(token)); return null; } s.lastSeen = Date.now(); p.setProperty(sessionKey_(token), json_(s)); return s; }
function requireSession_(token, types) { const s = getSession_(token); if (!s || (types && types.indexOf(s.type) === -1)) throw new Error('Sesi tidak sah. Sila login semula.'); return s; }
function requireTeacher_(token) { return requireSession_(token, ['teacher']); }
function requireAdmin_(token) { const s = requireTeacher_(token); if (s.user.ROLE !== 'Admin') throw new Error('Admin sahaja dibenarkan.'); return s; }
function validateUrl_(url) { return /^https?:\/\/[^\s]+$/i.test(String(url || '')); }
function nextId_(name, prefix, width) { const lock = LockService.getScriptLock(); lock.waitLock(30000); try { const key = 'SEQ_' + name, p = PropertiesService.getScriptProperties(), n = Number(p.getProperty(key) || 0) + 1; p.setProperty(key, String(n)); return prefix + '-' + String(n).padStart(width, '0'); } finally { lock.releaseLock(); } }

function initializeSheets() {
  const ss = getSpreadsheet_();
  Object.keys(APP_CONFIG.SHEETS).forEach(name => { const sh = ss.getSheetByName(name) || ss.insertSheet(name); const h = APP_CONFIG.SHEETS[name]; if (sh.getLastRow() === 0) sh.getRange(1,1,1,h.length).setValues([h]); });
  seedDefaults_(); cacheRemove_(); return ok_({ spreadsheetId: ss.getId() }, 'Struktur Google Sheet disediakan.');
}
function seedDefaults_() {
  const stamp = fmt_(now_(), 'dd/MM/yyyy HH:mm:ss');
  if (!rows_('SETTINGS').length) Object.keys(APP_CONFIG.DEFAULT_SETTINGS).forEach(k => append_('SETTINGS', { SETTING_KEY:k, SETTING_VALUE:APP_CONFIG.DEFAULT_SETTINGS[k], UPDATED_BY:'SYSTEM', UPDATED_AT:stamp }));
  if (!rows_('FIELDS').length) LEARNING_FIELDS.forEach(r => append_('FIELDS', Object.fromEntries(headers_('FIELDS').map((h,i)=>[h,r[i]]))));
  if (!rows_('STANDARD_PEMBELAJARAN').length) DEMO_STANDARDS.forEach(r => append_('STANDARD_PEMBELAJARAN', Object.fromEntries(headers_('STANDARD_PEMBELAJARAN').map((h,i)=>[h,r[i]]))));
  if (!rows_('STUDENTS').length) DEMO_STUDENTS.forEach(r => append_('STUDENTS', { STUDENT_ID:r[0], STUDENT_NAME:r[1], CLASS:r[2], PASSWORD:r[3], AVATAR_URL:r[4], STATUS:r[5], YEAR:r[6], CREATED_AT:stamp, UPDATED_AT:stamp }));
  if (!rows_('TEACHERS').length) append_('TEACHERS', { TEACHER_ID:'TCH-0001', TEACHER_NAME:'ADMIN iGEMKIDS', USERNAME:'admin', PASSWORD_HASH:hashPassword_(APP_CONFIG.DEMO_PASSWORDS.ADMIN), ROLE:'Admin', STATUS:'AKTIF', CREATED_AT:stamp, UPDATED_AT:stamp });
  if (!rows_('GAMES').length) DEMO_GAMES.forEach(r => append_('GAMES', Object.assign(Object.fromEntries(headers_('GAMES').map((h,i)=>[h,r[i]])), { CREATED_AT:stamp, UPDATED_AT:stamp })));
}

function getSystemSettings() { const c = CacheService.getScriptCache(), hit = c.get('settings'); if (hit) return JSON.parse(hit); const data = Object.assign({}, APP_CONFIG.DEFAULT_SETTINGS); rows_('SETTINGS').forEach(r => data[r.SETTING_KEY] = r.SETTING_VALUE); c.put('settings', json_(data), APP_CONFIG.CACHE_TTL_SECONDS); return data; }
function updateSystemSettings(payload, token) { try { const s = requireTeacher_(token), stamp = fmt_(now_(),'dd/MM/yyyy HH:mm:ss'), existing = rows_('SETTINGS'), map = Object.fromEntries(existing.map(r=>[r.SETTING_KEY,r])); Object.keys(payload || {}).forEach(k => { map[k] = { SETTING_KEY:k, SETTING_VALUE:clean_(payload[k]), UPDATED_BY:s.user.TEACHER_ID, UPDATED_AT:stamp }; }); writeRows_('SETTINGS', Object.values(map)); cacheRemove_(); writeActivityLog('teacher', s.user.TEACHER_ID, 'UPDATE_SETTINGS', '', json_(payload)); return ok_(getSystemSettings(), 'Tetapan berjaya dikemas kini.'); } catch(e){ return fail_(e.message); } }
function loginStudent(password, deviceInfo) { const pass = normalizePassword_(password), students = rows_('STUDENTS'), matches = students.filter(s => normalizePassword_(s.PASSWORD) === pass && normalizePassword_(s.STATUS) === 'AKTIF'); const stu = matches.length === 1 ? matches[0] : null; writeLogin_('STUDENT', stu?stu.STUDENT_ID:'', stu?stu.STUDENT_NAME:'Tidak diketahui', stu?'BERJAYA':'GAGAL', deviceInfo); if (matches.length > 1) return fail_('Kata laluan digunakan oleh lebih daripada seorang murid. Sila hubungi guru.'); if (!stu) return fail_('Kata laluan tidak betul. Semak STUDENTS > PASSWORD dan pastikan STATUS ialah AKTIF.'); const safe = Object.assign({}, stu); delete safe.PASSWORD; return ok_({ token:createSession_('student', safe), type:'student', user:safe }, 'Selamat datang, ' + safe.STUDENT_NAME + '.'); }
function loginTeacher(username, password, deviceInfo) { const u = normalizeLogin_(username), p = String(password == null ? '' : password).trim(), h = hashPassword_(p), teachers = rows_('TEACHERS'); const t = teachers.find(x => (normalizeLogin_(x.USERNAME) === u || normalizeLogin_(x.TEACHER_ID) === u || normalizeLogin_(x.TEACHER_NAME) === u) && normalizePassword_(x.STATUS) === 'AKTIF' && teacherPasswordMatches_(x, p, h)); writeLogin_('TEACHER', t?t.TEACHER_ID:'', t?t.TEACHER_NAME:u, t?'BERJAYA':'GAGAL', deviceInfo); if (!t) return fail_('ID guru atau kata laluan tidak betul. Semak TEACHERS, STATUS=AKTIF dan kolum PASSWORD_HASH atau PASSWORD.'); const safe = Object.assign({}, t); delete safe.PASSWORD_HASH; delete safe.PASSWORD_H; delete safe.PASSWORD; delete safe.KATA_LALUAN; return ok_({ token:createSession_('teacher', safe), type:'teacher', user:safe }, 'Login guru berjaya.'); }
function logoutUser(token) { if (token) PropertiesService.getScriptProperties().deleteProperty(sessionKey_(token)); return ok_({}, 'Log keluar berjaya.'); }
function validateSession(token) { const s = getSession_(token); return s ? ok_({ type:s.type, user:s.user }) : fail_('Sesi tamat.'); }
function writeLogin_(type,id,name,status,device) { append_('LOGIN_LOG', { LOGIN_ID:nextId_('LOGIN','LOG',6), USER_TYPE:type, USER_ID:id, USER_NAME:name, LOGIN_DATE:fmt_(now_(),'yyyy-MM-dd'), LOGIN_TIME:fmt_(now_(),'HH:mm:ss'), LOGIN_STATUS:status, DEVICE_INFO:clean_(device) }); }
function writeActivityLog(userType, userId, action, referenceId, details) { append_('ACTIVITY_LOG', { LOG_ID:nextId_('ACTIVITY','ACT',6), USER_TYPE:userType, USER_ID:userId, ACTION:action, REFERENCE_ID:referenceId, DETAILS:details, LOG_DATE:fmt_(now_(),'yyyy-MM-dd'), LOG_TIME:fmt_(now_(),'HH:mm:ss') }); }

function getFields() { return rows_('FIELDS').filter(r=>r.STATUS !== 'DIPADAM'); }
function getStandardsByField(fieldId) { return rows_('STANDARD_PEMBELAJARAN').filter(r => (!fieldId || r.FIELD_ID === fieldId) && r.STATUS === 'AKTIF'); }
function activeGames_() { return rows_('GAMES').filter(g => g.STATUS === 'AKTIF'); }
function getGamesByField(fieldId, token) { const s = requireSession_(token, ['student','teacher']); return ok_(decorateGames_(activeGames_().filter(g => !fieldId || g.FIELD_ID === fieldId), s.user.STUDENT_ID)); }
function getGamesByStandard(standardId, token) { const s = requireSession_(token, ['student','teacher']); return ok_(decorateGames_(activeGames_().filter(g => !standardId || g.STANDARD_ID === standardId), s.user.STUDENT_ID)); }
function getStudentGames(token, studentId) { const s = requireSession_(token, ['student','teacher']), id = s.type === 'student' ? s.user.STUDENT_ID : clean_(studentId); return ok_({ fields:getFields(), standards:getStandardsByField(''), games:decorateGames_(activeGames_(), id) }); }
function decorateGames_(games, studentId) { const res = rows_('GAME_RESULTS').filter(r => r.STUDENT_ID === studentId); return games.map(g => { const mine = res.filter(r=>r.GAME_ID===g.GAME_ID); const best = mine.reduce((m,r)=>Math.max(m, Number(r.SCORE)||0),0); const last = mine[mine.length-1] || {}; return Object.assign({}, g, { BEST_SCORE:best, PLAY_STATUS: mine.length ? 'Selesai' : 'Belum dimainkan', LAST_PLAYED:last.PLAY_DATE || '' }); }).sort((a,b)=>String(a.STANDARD_CODE).localeCompare(String(b.STANDARD_CODE)) || String(a.GAME_NAME).localeCompare(String(b.GAME_NAME))); }
function leaderboard_() { const students = rows_('STUDENTS').filter(s=>s.STATUS==='AKTIF'), results = rows_('GAME_RESULTS'); return students.map(st => { const rs = results.filter(r=>r.STUDENT_ID===st.STUDENT_ID), total = rs.reduce((a,r)=>a+(Number(r.SCORE)||0),0), dur = rs.reduce((a,r)=>a+(Number(r.DURATION_SECONDS)||0),0); return { STUDENT_ID:st.STUDENT_ID, STUDENT_NAME:st.STUDENT_NAME, CLASS:st.CLASS, totalScore:total, averageScore:rs.length?Math.round(total/rs.length):0, completed:rs.length, success:rs.filter(r=>String(r.RESULT_STATUS).toLowerCase().indexOf('berjaya')>-1 || String(r.RESULT_STATUS).toLowerCase().indexOf('completed')>-1).length, totalDuration:dur, lastActivity:rs.length?rs[rs.length-1].CREATED_AT:'' }; }).sort((a,b)=>b.totalScore-a.totalScore).map((r,i)=>Object.assign({ rank:i+1 }, r)); }
function getLeaderboard() { return ok_(leaderboard_()); }
function getStudentDashboard(token) { try { const s = requireSession_(token, ['student']), id = s.user.STUDENT_ID, lb = leaderboard_(), me = lb.find(r=>r.STUDENT_ID===id) || {}, results = rows_('GAME_RESULTS').filter(r=>r.STUDENT_ID===id).slice(-20).reverse(); return ok_({ settings:getSystemSettings(), student:s.user, todayAssignments:getAssignmentsForStudent_(s.user), summary:me, recentResults:results, charts:chartData_(results), games:decorateGames_(activeGames_(), id) }); } catch(e){ return fail_(e.message); } }
function getAssignmentsForStudent_(student) { const today = fmt_(now_(),'yyyy-MM-dd'); return rows_('DAILY_ASSIGNMENTS').filter(a => a.STATUS === 'AKTIF' && a.START_DATE <= today && a.END_DATE >= today && (a.TARGET_TYPE === 'SEMUA' || a.TARGET_CLASS === student.CLASS || a.TARGET_STUDENT_ID === student.STUDENT_ID)).map(a => Object.assign({}, a, activeGames_().find(g=>g.GAME_ID===a.GAME_ID) || {})); }
function chartData_(results) { return { byDate: results.map(r=>({ label:r.PLAY_DATE, value:Number(r.SCORE)||0 })), byField: Object.values(results.reduce((m,r)=>{ m[r.FIELD_NAME]=m[r.FIELD_NAME]||{label:r.FIELD_NAME,value:0}; m[r.FIELD_NAME].value += Number(r.SCORE)||0; return m; },{})) }; }
function getTeacherDashboard(token) { try { requireTeacher_(token); const lb = leaderboard_(), games = rows_('GAMES').filter(g=>g.STATUS!=='DIPADAM'), results = rows_('GAME_RESULTS'), today = fmt_(now_(),'yyyy-MM-dd'); return ok_({ settings:getSystemSettings(), summary:{ totalStudents:lb.length, activeToday:new Set(results.filter(r=>r.PLAY_DATE===today).map(r=>r.STUDENT_ID)).size, totalGames:games.length, gamesToday:results.filter(r=>r.PLAY_DATE===today).length, totalScore:results.reduce((a,r)=>a+(Number(r.SCORE)||0),0), averageScore:results.length?Math.round(results.reduce((a,r)=>a+(Number(r.SCORE)||0),0)/results.length):0, mostActive:lb[0]?lb[0].STUDENT_NAME:'-', popularGame:popular_(results,'GAME_NAME') }, leaderboard:lb, recent:results.slice(-15).reverse(), charts:{ byField:chartData_(results).byField } }); } catch(e){ return fail_(e.message); } }
function popular_(rows,key){ const m={}; rows.forEach(r=>m[r[key]]=(m[r[key]]||0)+1); return Object.keys(m).sort((a,b)=>m[b]-m[a])[0] || '-'; }
function getTeacherAnalytics(token) { return getTeacherDashboard(token); }

function addGame(payload, token) { try { const s=requireTeacher_(token), p=payload||{}; if (!p.GAME_NAME || !validateUrl_(p.GAME_URL)) return fail_('Nama permainan dan pautan sah diperlukan.'); const std = rows_('STANDARD_PEMBELAJARAN').find(x=>x.STANDARD_ID===p.STANDARD_ID) || {}; const field = rows_('FIELDS').find(x=>x.FIELD_ID===(p.FIELD_ID||std.FIELD_ID)) || {}; const stamp=fmt_(now_(),'dd/MM/yyyy HH:mm:ss'), obj={ GAME_ID:nextId_('GAME','GME',4), GAME_NAME:clean_(p.GAME_NAME), GAME_URL:clean_(p.GAME_URL), THUMBNAIL_URL:clean_(p.THUMBNAIL_URL), FIELD_ID:field.FIELD_ID, FIELD_NAME:field.FIELD_NAME, STANDARD_ID:std.STANDARD_ID, STANDARD_CODE:std.STANDARD_CODE, STANDARD_DESCRIPTION:std.STANDARD_DESCRIPTION, GAME_DESCRIPTION:clean_(p.GAME_DESCRIPTION), GAME_INSTRUCTION:clean_(p.GAME_INSTRUCTION), DIFFICULTY:clean_(p.DIFFICULTY||'Mudah'), MAX_SCORE:Number(p.MAX_SCORE)||100, ESTIMATED_TIME:clean_(p.ESTIMATED_TIME||'10 minit'), GAME_TYPE:clean_(p.GAME_TYPE||'Interaktif'), SCORE_METHOD:clean_(p.SCORE_METHOD||'MANUAL'), STATUS:clean_(p.STATUS||'AKTIF'), CREATED_BY:s.user.TEACHER_ID, CREATED_AT:stamp, UPDATED_AT:stamp }; append_('GAMES', obj); cacheRemove_(); writeActivityLog('teacher',s.user.TEACHER_ID,'ADD_GAME',obj.GAME_ID,obj.GAME_NAME); return ok_(obj,'Permainan berjaya ditambah.'); } catch(e){ return fail_(e.message); } }
function updateGame(gameId,payload,token){ try{ const s=requireTeacher_(token), rows=rows_('GAMES'), i=rows.findIndex(g=>g.GAME_ID===gameId); if(i<0)return fail_('Permainan tidak ditemui.'); Object.assign(rows[i], payload||{}, { UPDATED_AT:fmt_(now_(),'dd/MM/yyyy HH:mm:ss') }); writeRows_('GAMES',rows); cacheRemove_(); writeActivityLog('teacher',s.user.TEACHER_ID,'UPDATE_GAME',gameId,json_(payload)); return ok_(rows[i],'Permainan berjaya dikemas kini.'); }catch(e){return fail_(e.message);} }
function deleteGame(gameId,token){ return updateGame(gameId,{STATUS:'DIPADAM'},token); }
function toggleGameStatus(gameId,token){ const g=rows_('GAMES').find(x=>x.GAME_ID===gameId); return updateGame(gameId,{STATUS:g && g.STATUS==='AKTIF'?'TIDAK AKTIF':'AKTIF'},token); }
function getStudents(token){ try{ requireTeacher_(token); return ok_(rows_('STUDENTS').filter(s=>s.STATUS!=='DIPADAM')); }catch(e){return fail_(e.message);} }
function generateStudentPassword_(name){ return 'SKL-' + clean_(name).split(/\s+/)[0].toUpperCase() + '-' + Math.floor(1000+Math.random()*9000); }
function addStudent(payload,token){ try{ const s=requireTeacher_(token), p=payload||{}, stamp=fmt_(now_(),'dd/MM/yyyy HH:mm:ss'); if(!p.STUDENT_NAME || !p.CLASS)return fail_('Nama murid dan kelas diperlukan.'); const obj={ STUDENT_ID:nextId_('STUDENT','STU',4), STUDENT_NAME:clean_(p.STUDENT_NAME).toUpperCase(), CLASS:clean_(p.CLASS).toUpperCase(), PASSWORD:p.PASSWORD||generateStudentPassword_(p.STUDENT_NAME), AVATAR_URL:clean_(p.AVATAR_URL), STATUS:'AKTIF', YEAR:getSystemSettings().CURRENT_YEAR, CREATED_AT:stamp, UPDATED_AT:stamp }; append_('STUDENTS',obj); writeActivityLog('teacher',s.user.TEACHER_ID,'ADD_STUDENT',obj.STUDENT_ID,obj.STUDENT_NAME); return ok_(obj,'Murid berjaya ditambah.'); }catch(e){return fail_(e.message);} }
function updateStudent(id,payload,token){ try{ requireTeacher_(token); const rs=rows_('STUDENTS'), i=rs.findIndex(r=>r.STUDENT_ID===id); if(i<0)return fail_('Murid tidak ditemui.'); Object.assign(rs[i], payload||{}, { UPDATED_AT:fmt_(now_(),'dd/MM/yyyy HH:mm:ss') }); writeRows_('STUDENTS',rs); return ok_(rs[i],'Murid berjaya dikemas kini.'); }catch(e){return fail_(e.message);} }
function resetStudentPassword(id,token){ const st=rows_('STUDENTS').find(r=>r.STUDENT_ID===id); return updateStudent(id,{PASSWORD:generateStudentPassword_(st?st.STUDENT_NAME:'MURID')},token); }
function deleteStudent(id,token){ return updateStudent(id,{STATUS:'DIPADAM'},token); }
function createDailyAssignment(payload,token){ try{ const s=requireTeacher_(token), p=payload||{}, g=rows_('GAMES').find(x=>x.GAME_ID===p.GAME_ID); if(!g)return fail_('Sila pilih permainan.'); const obj={ ASSIGNMENT_ID:nextId_('ASSIGNMENT','ASN',4), ASSIGNMENT_NAME:clean_(p.ASSIGNMENT_NAME||g.GAME_NAME), ASSIGNMENT_DATE:p.ASSIGNMENT_DATE||fmt_(now_(),'yyyy-MM-dd'), GAME_ID:g.GAME_ID, GAME_NAME:g.GAME_NAME, TARGET_TYPE:clean_(p.TARGET_TYPE||'SEMUA'), TARGET_CLASS:clean_(p.TARGET_CLASS), TARGET_STUDENT_ID:clean_(p.TARGET_STUDENT_ID), INSTRUCTION:clean_(p.INSTRUCTION), IS_REQUIRED:p.IS_REQUIRED?'YA':'TIDAK', START_DATE:p.START_DATE||fmt_(now_(),'yyyy-MM-dd'), END_DATE:p.END_DATE||fmt_(now_(),'yyyy-MM-dd'), STATUS:clean_(p.STATUS||'AKTIF'), CREATED_BY:s.user.TEACHER_ID, CREATED_AT:fmt_(now_(),'dd/MM/yyyy HH:mm:ss')}; append_('DAILY_ASSIGNMENTS',obj); return ok_(obj,'Tugasan berjaya ditetapkan.'); }catch(e){return fail_(e.message);} }
function updateDailyAssignment(id,payload,token){ try{ requireTeacher_(token); const rs=rows_('DAILY_ASSIGNMENTS'), i=rs.findIndex(r=>r.ASSIGNMENT_ID===id); if(i<0)return fail_('Tugasan tidak ditemui.'); Object.assign(rs[i],payload||{}); writeRows_('DAILY_ASSIGNMENTS',rs); return ok_(rs[i],'Tugasan dikemas kini.'); }catch(e){return fail_(e.message);} }
function deleteDailyAssignment(id,token){ return updateDailyAssignment(id,{STATUS:'DIPADAM'},token); }
function getDailyAssignments(token){ try{ requireTeacher_(token); return ok_(rows_('DAILY_ASSIGNMENTS').filter(a=>a.STATUS!=='DIPADAM')); }catch(e){return fail_(e.message);} }
function startGameSession(gameId, token, studentId){ try{ const s=requireSession_(token,['student','teacher']), id=s.type==='student'?s.user.STUDENT_ID:studentId, st=rows_('STUDENTS').find(x=>x.STUDENT_ID===id), g=activeGames_().find(x=>x.GAME_ID===gameId); if(!st||!g)return fail_('Murid atau permainan tidak ditemui.'); const ses={ SESSION_ID:nextId_('SESSION','SES',6), STUDENT_ID:id, GAME_ID:gameId, START_TIME:fmt_(now_(),'HH:mm:ss'), START_TS:Date.now(), PLAY_MODE:s.type==='teacher'?'GURU':'MURID', TEACHER_ID:s.type==='teacher'?s.user.TEACHER_ID:'' }; PropertiesService.getScriptProperties().setProperty('GAME_'+ses.SESSION_ID,json_(ses)); return ok_(Object.assign(ses,{ student:st, game:g }),'Permainan dimulakan.'); }catch(e){return fail_(e.message);} }
function completeGameSession(sessionId,result,token){ try{ requireSession_(token,['student','teacher']); const raw=PropertiesService.getScriptProperties().getProperty('GAME_'+sessionId); if(!raw)return fail_('Sesi permainan tidak ditemui.'); return saveGameResult(Object.assign(JSON.parse(raw), result||{}), token); }catch(e){return fail_(e.message);} }
function saveGameResult(payload,token){ const lock=LockService.getScriptLock(); lock.waitLock(30000); try{ const s=requireSession_(token,['student','teacher']), p=payload||{}, st=rows_('STUDENTS').find(x=>x.STUDENT_ID===p.STUDENT_ID), g=rows_('GAMES').find(x=>x.GAME_ID===p.GAME_ID); if(!st||!g)return fail_('Data markah tidak sah.'); if(s.type==='student' && s.user.STUDENT_ID!==st.STUDENT_ID)return fail_('Murid hanya boleh menyimpan markah sendiri.'); const max=Number(p.MAX_SCORE||g.MAX_SCORE||100), score=Math.max(0,Math.min(Number(p.SCORE||p.score||0),max)), end=now_(), duration=p.START_TS?Math.round((Date.now()-Number(p.START_TS))/1000):Number(p.DURATION_SECONDS||0), attempt=rows_('GAME_RESULTS').filter(r=>r.STUDENT_ID===st.STUDENT_ID&&r.GAME_ID===g.GAME_ID).length+1; const obj={ RESULT_ID:nextId_('RESULT','RES',6), SESSION_ID:p.SESSION_ID||nextId_('SESSION','SES',6), STUDENT_ID:st.STUDENT_ID, STUDENT_NAME:st.STUDENT_NAME, CLASS:st.CLASS, GAME_ID:g.GAME_ID, GAME_NAME:g.GAME_NAME, FIELD_ID:g.FIELD_ID, FIELD_NAME:g.FIELD_NAME, STANDARD_ID:g.STANDARD_ID, STANDARD_CODE:g.STANDARD_CODE, PLAY_DATE:fmt_(end,'yyyy-MM-dd'), START_TIME:p.START_TIME||fmt_(end,'HH:mm:ss'), END_TIME:fmt_(end,'HH:mm:ss'), DURATION_SECONDS:duration, SCORE:score, MAX_SCORE:max, SCORE_PERCENTAGE:max?Math.round(score/max*100):0, ATTEMPT_NUMBER:attempt, RESULT_STATUS:clean_(p.RESULT_STATUS||p.status||'completed'), PLAY_MODE:p.PLAY_MODE||s.type.toUpperCase(), TEACHER_ID:p.TEACHER_ID||'', NOTES:clean_(p.NOTES), CREATED_AT:fmt_(end,'dd/MM/yyyy HH:mm:ss')}; append_('GAME_RESULTS',obj); writeActivityLog(s.type,s.user.STUDENT_ID||s.user.TEACHER_ID,'SAVE_RESULT',obj.RESULT_ID,json_({score})); return ok_(obj,'Markah berjaya direkodkan.'); }catch(e){return fail_(e.message);} finally{ lock.releaseLock(); } }
function getStudentResults(studentId,token){ try{ const s=requireSession_(token,['student','teacher']), id=s.type==='student'?s.user.STUDENT_ID:studentId; return ok_(rows_('GAME_RESULTS').filter(r=>r.STUDENT_ID===id)); }catch(e){return fail_(e.message);} }
function getReports(token,filters){ try{ requireTeacher_(token); return ok_({ leaderboard:leaderboard_(), results:rows_('GAME_RESULTS'), games:rows_('GAMES'), students:rows_('STUDENTS'), filters:filters||{} }); }catch(e){return fail_(e.message);} }
function exportReportToPdf(token){ try{ requireTeacher_(token); const blob=Utilities.newBlob(JSON.stringify(getReports(token).data,null,2),'application/json','igemkids-report.json'); return ok_({ fileName:blob.getName(), content:Utilities.base64Encode(blob.getBytes()) },'Laporan eksport dijana.'); }catch(e){return fail_(e.message);} }
function archiveCurrentYear(token){ try{ const s=requireAdmin_(token), y=getSystemSettings().CURRENT_YEAR; ['GAME_RESULTS','DAILY_ASSIGNMENTS','GROUP_SESSIONS'].forEach(name=>append_('YEAR_ARCHIVE',{ARCHIVE_ID:nextId_('ARCHIVE','ARC',6),ARCHIVE_YEAR:y,ARCHIVE_TYPE:'BACKUP',SOURCE_SHEET:name,RECORD_COUNT:rows_(name).length,ARCHIVED_BY:s.user.TEACHER_ID,ARCHIVED_AT:fmt_(now_(),'dd/MM/yyyy HH:mm:ss')})); return ok_({},'Data tahun semasa diarkibkan.'); }catch(e){return fail_(e.message);} }
function resetNewYear(newYear, keepStudents, confirmText, token){ try{ requireAdmin_(token); if(confirmText!=='RESET')return fail_('Taip RESET untuk pengesahan.'); archiveCurrentYear(token); writeRows_('GAME_RESULTS',[]); writeRows_('DAILY_ASSIGNMENTS',[]); writeRows_('GROUP_SESSIONS',[]); if(!keepStudents) writeRows_('STUDENTS',[]); return updateSystemSettings({CURRENT_YEAR:newYear},token); }catch(e){return fail_(e.message);} }
function uploadSchoolLogo(base64,name,mime,token){ try{ const s=requireTeacher_(token), bytes=Utilities.base64Decode(String(base64).split(',').pop()), file=DriveApp.createFile(Utilities.newBlob(bytes,mime||'image/png',name||'logo.png')); file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW); return updateSystemSettings({LOGO_URL:file.getUrl()},token); }catch(e){return fail_(e.message);} }
