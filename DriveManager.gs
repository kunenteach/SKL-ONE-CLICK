function ensureFolders_(){const props=PropertiesService.getScriptProperties(); let main=getFolder_(CONFIG.MAIN_FOLDER_ID||props.getProperty('MAIN_FOLDER_ID')); if(!main)main=DriveApp.createFolder('ONE PAGE REPORT SK LORMALONG'); let images=getFolder_(CONFIG.IMAGE_FOLDER_ID||props.getProperty('IMAGE_FOLDER_ID')); if(!images)images=main.createFolder('GAMBAR'); let pdf=getFolder_(CONFIG.PDF_FOLDER_ID||props.getProperty('PDF_FOLDER_ID')); if(!pdf)pdf=main.createFolder('PDF'); props.setProperties({MAIN_FOLDER_ID:main.getId(),IMAGE_FOLDER_ID:images.getId(),PDF_FOLDER_ID:pdf.getId()}); return {main:main.getId(),images:images.getId(),pdf:pdf.getId()};}
function getFolder_(id){if(!id)return null;try{return DriveApp.getFolderById(id);}catch(e){return null;}}
function getImageFolder_(){const p=PropertiesService.getScriptProperties(); return getFolder_(CONFIG.IMAGE_FOLDER_ID||p.getProperty('IMAGE_FOLDER_ID'))||getFolder_(ensureFolders_().images);}
function getPdfFolder_(){const p=PropertiesService.getScriptProperties(); return getFolder_(CONFIG.PDF_FOLDER_ID||p.getProperty('PDF_FOLDER_ID'))||getFolder_(ensureFolders_().pdf);}
/** Memuat naik data URI imej yang telah dimampatkan oleh pelayar. */
function uploadImages(images,reportId){validateReportId_(reportId); const allowed=['image/jpeg','image/png','image/webp'],folder=getImageFolder_(),result=[]; (images||[]).forEach((img,i)=>{const match=String(img.data||'').match(/^data:(image\/(?:jpeg|png|webp));base64,([A-Za-z0-9+/=]+)$/); if(!match||!allowed.includes(match[1]))throw new Error('Format gambar tidak disokong.'); const bytes=Utilities.base64Decode(match[2]); if(bytes.length>CONFIG.MAX_IMAGE_BYTES)throw new Error('Gambar melebihi had 8 MB.'); const ext=match[1]==='image/png'?'.png':match[1]==='image/webp'?'.webp':'.jpg',blob=Utilities.newBlob(bytes,match[1],reportId+'_'+(i+1)+ext),file=folder.createFile(blob); result.push({fileId:file.getId(),url:file.getUrl(),caption:cleanText_(img.caption,300),mimeType:match[1]});}); return {success:true,images:result};}
function trashFile_(id){try{DriveApp.getFileById(id).setTrashed(true);}catch(e){console.warn('Fail tidak dapat dipadam: '+id);}}
function fileToDataUri_(id){if(!id)return '';try{const b=DriveApp.getFileById(id).getBlob();return 'data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes());}catch(e){return '';}}
function getLogoDataUri_(){const value=CONFIG.SCHOOL_LOGO_URL; if(!value)return ''; const id=(value.match(/[-\w]{25,}/)||[])[0]; if(id)return fileToDataUri_(id); try{const b=UrlFetchApp.fetch(value,{muteHttpExceptions:true}).getBlob();return 'data:'+b.getContentType()+';base64,'+Utilities.base64Encode(b.getBytes());}catch(e){return '';}}
/** Endpoint lencana berasingan supaya kegagalannya tidak menjejaskan data borang. */
function getSchoolLogoData(){return {logo:getLogoDataUri_()};}
