function buildTemplateData_(data){data=Object.assign({},data); data.formattedDate=formatMalayDate(data.date); data.displayOrganiser=data.organiser.toUpperCase()==='LAIN-LAIN'?data.otherOrganiser:data.organiser; data.logoData=getLogoDataUri_(); data.images=(data.images||data.existingImages||[]).map(x=>{const source=fileToDataUri_(x.fileId)||x.data||'',safe=/^data:image\/(?:jpeg|png|webp);base64,[A-Za-z0-9+/=]+$/.test(source)?source:'';return Object.assign({},x,{data:safe});}).filter(x=>x.data); const length=[data.objective1,data.objective2,data.impact,data.achievement,data.improvement].join('').length; data.layoutClass='images-'+Math.min(7,data.images.length)+' '+(data.images.length?'has-images':'no-images')+' '+(length>900?'text-dense':length>500?'text-medium':''); return data;}
function renderReport_(data){const t=HtmlService.createTemplateFromFile('ReportTemplate'); t.report=buildTemplateData_(data); t.school={name:CONFIG.SCHOOL_NAME,slogan:CONFIG.SCHOOL_SLOGAN}; return t.evaluate().getContent();}
function generatePreview(formData){const d=normaliseForm_(formData); return {success:true,html:renderReport_(d)};}
function generateReportPdf(reportId){const r=getReportById(reportId),html=renderReport_(r),name=safeFileName_('OPR_'+r.unit+'_'+r.name+'_'+r.date)+'.pdf'; const blob=Utilities.newBlob(html,MimeType.HTML,name.replace(/\.pdf$/,'.html')).getAs(MimeType.PDF).setName(name),folder=getPdfFolder_(); if(r.pdfFileId)trashFile_(r.pdfFileId); const file=folder.createFile(blob),found=findReportRow_(reportId); found.sheet.getRange(found.row,REPORT_HEADERS.indexOf('URL PDF')+1,1,2).setValues([[file.getUrl(),file.getId()]]); logActivity(reportId,'Jana PDF',name); return {success:true,url:file.getUrl(),downloadUrl:'https://drive.google.com/uc?export=download&id='+file.getId(),fileId:file.getId()};}
function safeFileName_(s){return cleanText_(s,180).replace(/[\\/:*?"<>|#%{}]/g,'_').replace(/\s+/g,'_');}
